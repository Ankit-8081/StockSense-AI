# Backend/.env — copy this file and fill in your keys

DATABASE_URL=sqlite:///./stocksense.db

GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxx
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxx

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"  (the app refuses the example value)
SECRET_KEY=replace-with-a-random-48-character-value

# development | production (production turns off /docs and adds HSTS)
ENVIRONMENT=development
# Allowed frontend origins, comma separated
ALLOWED_ORIGINS=http://localhost:5173
# Set to 1 only if every account may use the server-owned AI keys above (they cost you money)
ALLOW_SERVER_KEYS=0
# Optional: separate key for encrypting users' saved API keys
# ENCRYPTION_KEY=
